{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Minecraft Server GUI",
  "version": "0.1.0",
  "identifier": "norditex.minecraft-server-gui",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Minecraft Server GUI",
        "width": 1000,
        "height": 720,
        "minWidth": 820,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
