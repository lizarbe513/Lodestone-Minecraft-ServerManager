{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lodestone",
  "version": "1.0.0-beta.1",
  "identifier": "com.lizarbe513.lodestone",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Lodestone - Minecraft Server Manager",
        "width": 1000,
        "height": 720,
        "minWidth": 820,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
